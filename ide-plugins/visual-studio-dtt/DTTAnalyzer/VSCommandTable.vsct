<?xml version="1.0" encoding="utf-8"?>
<CommandTable xmlns="http://schemas.microsoft.com/VisualStudio/2005-10-18/CommandTable" xmlns:xs="http://www.w3.org/2001/XMLSchema">

  <Extern href="stdidcmd.h"/>
  <Extern href="vsshlids.h"/>
  <Include href="KnownImageIds.vsct"/>
  <Include href="VSGlobals.vsct"/>

  <Commands package="DTTAnalyzer">
    <Groups>
      <Group guid="DTTAnalyzer" id="DTTMenuGroup" priority="0x0600">
        <Parent guid="VSMainMenu" id="Tools"/>
      </Group>
      <Group guid="DTTAnalyzer" id="DTTContextMenuGroup" priority="0x0100">
        <Parent guid="guidSHLMainMenu" id="IDM_VS_CTXT_CODEWIN"/>
      </Group>
    </Groups>

    <Menus>
      <Menu guid="DTTAnalyzer" id="DTTSubMenu" type="Menu" priority="0x0100">
        <Parent guid="DTTAnalyzer" id="DTTMenuGroup"/>
        <Strings>
          <ButtonText>DTT Analysis</ButtonText>
        </Strings>
      </Menu>
    </Menus>

    <Buttons>
      <Button guid="DTTAnalyzer" id="AnalyzeFileCommand" priority="0x0100" type="Button">
        <Parent guid="DTTAnalyzer" id="DTTSubMenu"/>
        <Icon guid="ImageCatalogGuid" id="StatusSecurityOK"/>
        <CommandFlag>IconIsMoniker</CommandFlag>
        <Strings>
          <ButtonText>Analyze Current File</ButtonText>
          <LocCanonicalName>.DTT.AnalyzeFile</LocCanonicalName>
        </Strings>
      </Button>
      <Button guid="DTTAnalyzer" id="AnalyzeSolutionCommand" priority="0x0200" type="Button">
        <Parent guid="DTTAnalyzer" id="DTTSubMenu"/>
        <Icon guid="ImageCatalogGuid" id="BuildSolution"/>
        <CommandFlag>IconIsMoniker</CommandFlag>
        <Strings>
          <ButtonText>Analyze Solution</ButtonText>
          <LocCanonicalName>.DTT.AnalyzeSolution</LocCanonicalName>
        </Strings>
      </Button>
      <Button guid="DTTAnalyzer" id="ClearDiagnosticsCommand" priority="0x0300" type="Button">
        <Parent guid="DTTAnalyzer" id="DTTSubMenu"/>
        <Icon guid="ImageCatalogGuid" id="ClearWindowContent"/>
        <CommandFlag>IconIsMoniker</CommandFlag>
        <Strings>
          <ButtonText>Clear DTT Diagnostics</ButtonText>
          <LocCanonicalName>.DTT.ClearDiagnostics</LocCanonicalName>
        </Strings>
      </Button>
      <Button guid="DTTAnalyzer" id="SettingsCommand" priority="0x0400" type="Button">
        <Parent guid="DTTAnalyzer" id="DTTSubMenu"/>
        <Icon guid="ImageCatalogGuid" id="Settings"/>
        <CommandFlag>IconIsMoniker</CommandFlag>
        <Strings>
          <ButtonText>DTT Settings...</ButtonText>
          <LocCanonicalName>.DTT.Settings</LocCanonicalName>
        </Strings>
      </Button>
      <!-- Context menu command -->
      <Button guid="DTTAnalyzer" id="AnalyzeFileContextCommand" priority="0x0100" type="Button">
        <Parent guid="DTTAnalyzer" id="DTTContextMenuGroup"/>
        <Icon guid="ImageCatalogGuid" id="StatusSecurityOK"/>
        <CommandFlag>IconIsMoniker</CommandFlag>
        <CommandFlag>DynamicVisibility</CommandFlag>
        <Strings>
          <ButtonText>DTT: Analyze File</ButtonText>
          <LocCanonicalName>.DTT.AnalyzeFileContext</LocCanonicalName>
        </Strings>
      </Button>
    </Buttons>
  </Commands>

  <Symbols>
    <GuidSymbol name="DTTAnalyzer" value="{a1b2c3d4-e5f6-7890-abcd-ef1234567890}">
      <IDSymbol name="DTTMenuGroup" value="0x1020"/>
      <IDSymbol name="DTTContextMenuGroup" value="0x1021"/>
      <IDSymbol name="DTTSubMenu" value="0x1100"/>
      <IDSymbol name="AnalyzeFileCommand" value="0x0100"/>
      <IDSymbol name="AnalyzeSolutionCommand" value="0x0101"/>
      <IDSymbol name="ClearDiagnosticsCommand" value="0x0102"/>
      <IDSymbol name="SettingsCommand" value="0x0103"/>
      <IDSymbol name="AnalyzeFileContextCommand" value="0x0104"/>
    </GuidSymbol>
  </Symbols>
</CommandTable>
