# Windows API Function Annotations for DTT
# All Win32 API semantic annotations in declarative form.
# Always registered (annotations for absent functions are inert).

# =========================================================================
# Named enumerations — replace magic 0/1 with readable constants
# =========================================================================

# HANDLE, HDC, GDI objects, heap handles
enum Handle {
  CLOSED = 0
  OPEN = 1
}

# SafeArray lifecycle
enum SafeArr {
  DESTROYED = 0
  VALID = 1
}

# Note: Alloc enum (FREED/ALLOCATED) is inherited from libc.dtt
# which loads before win32.dtt. Used for @allocated and @mapped.

# =========================================================================
# HANDLE lifecycle
# =========================================================================

# File/device handles — return INVALID_HANDLE_VALUE (-1) on failure, not NULL
fn CreateFileA(7) {
  ensures result.@handle = Handle.OPEN
  scope_exit result.@handle == Handle.CLOSED
}

fn CreateFileW(7) {
  ensures result.@handle = Handle.OPEN
  scope_exit result.@handle == Handle.CLOSED
}

fn FindFirstFileA(2) {
  ensures result.@handle = Handle.OPEN
  scope_exit result.@handle == Handle.CLOSED
}

fn FindFirstFileW(2) {
  ensures result.@handle = Handle.OPEN
  scope_exit result.@handle == Handle.CLOSED
}

# Kernel objects — return NULL on failure
fn CreateEventA(4) {
  ensures result.@handle = Handle.OPEN when result._nonnull != 0
  scope_exit result.@handle == Handle.CLOSED when result._nonnull != 0
}

fn CreateEventW(4) {
  ensures result.@handle = Handle.OPEN when result._nonnull != 0
  scope_exit result.@handle == Handle.CLOSED when result._nonnull != 0
}

fn CreateMutexA(3) {
  ensures result.@handle = Handle.OPEN when result._nonnull != 0
  scope_exit result.@handle == Handle.CLOSED when result._nonnull != 0
}

fn CreateMutexW(3) {
  ensures result.@handle = Handle.OPEN when result._nonnull != 0
  scope_exit result.@handle == Handle.CLOSED when result._nonnull != 0
}

fn CreateSemaphoreA(4) {
  ensures result.@handle = Handle.OPEN when result._nonnull != 0
  scope_exit result.@handle == Handle.CLOSED when result._nonnull != 0
}

fn CreateSemaphoreW(4) {
  ensures result.@handle = Handle.OPEN when result._nonnull != 0
  scope_exit result.@handle == Handle.CLOSED when result._nonnull != 0
}

fn CreateFileMappingA(6) {
  ensures result.@handle = Handle.OPEN when result._nonnull != 0
  scope_exit result.@handle == Handle.CLOSED when result._nonnull != 0
}

fn CreateFileMappingW(6) {
  ensures result.@handle = Handle.OPEN when result._nonnull != 0
  scope_exit result.@handle == Handle.CLOSED when result._nonnull != 0
}

# Handle close
fn CloseHandle(1) {
  requires arg0._nonnull != 0 "HANDLE may be invalid or already closed"
  ensures arg0.@handle = Handle.CLOSED
  ensures arg0._nonnull = 0
}

fn FindClose(1) {
  requires arg0._nonnull != 0 "HANDLE may be invalid or already closed"
  ensures arg0.@handle = Handle.CLOSED
  ensures arg0._nonnull = 0
}

# Find iteration
fn FindNextFileA(2) {
  requires arg0._nonnull != 0 "HANDLE may be invalid or already closed"
}

fn FindNextFileW(2) {
  requires arg0._nonnull != 0 "HANDLE may be invalid or already closed"
}

# GDI objects — return NULL on failure
fn CreateCompatibleDC(1) {
  ensures result.@handle = Handle.OPEN when result._nonnull != 0
  scope_exit result.@handle == Handle.CLOSED when result._nonnull != 0
}

fn DeleteDC(1) {
  requires arg0._nonnull != 0 "HDC may be invalid or already deleted"
  ensures arg0.@handle = Handle.CLOSED
  ensures arg0._nonnull = 0
}

fn DeleteObject(1) {
  requires arg0._nonnull != 0 "GDI object may be invalid or already deleted"
  ensures arg0.@handle = Handle.CLOSED
  ensures arg0._nonnull = 0
}

# Heap — return NULL on failure
fn HeapCreate(3) {
  ensures result.@heap = Handle.OPEN when result._nonnull != 0
  scope_exit result.@heap == Handle.CLOSED when result._nonnull != 0
}

fn HeapDestroy(1) {
  requires arg0._nonnull != 0 "Heap HANDLE may be invalid or already destroyed"
  ensures arg0.@heap = Handle.CLOSED
  ensures arg0._nonnull = 0
}

fn HeapAlloc(3) {
  ensures result.@allocated = Alloc.ALLOCATED when result._nonnull != 0
  scope_exit result.@allocated == Alloc.FREED when result._nonnull != 0
}

# HeapFree: arg2 is the pointer to free (not arg0)
fn HeapFree(3) {
  ensures arg2.@allocated = Alloc.FREED
}

# Memory-mapped files — return NULL on failure
fn MapViewOfFile(5) {
  ensures result.@mapped = Alloc.ALLOCATED when result._nonnull != 0
  scope_exit result.@mapped == Alloc.FREED when result._nonnull != 0
}

fn UnmapViewOfFile(1) {
  requires arg0._nonnull != 0 "View may be invalid or already unmapped"
  ensures arg0.@mapped = Alloc.FREED
  ensures arg0._nonnull = 0
}

# =========================================================================
# COM/OLE allocator pairs — return NULL on failure
# =========================================================================

# BSTR
fn SysAllocString(1) {
  ensures result.@allocated = Alloc.ALLOCATED when result._nonnull != 0
  scope_exit result.@allocated == Alloc.FREED when result._nonnull != 0
}

fn SysAllocStringLen(2) {
  ensures result.@allocated = Alloc.ALLOCATED when result._nonnull != 0
  scope_exit result.@allocated == Alloc.FREED when result._nonnull != 0
}

fn SysAllocStringByteLen(2) {
  ensures result.@allocated = Alloc.ALLOCATED when result._nonnull != 0
  scope_exit result.@allocated == Alloc.FREED when result._nonnull != 0
}

fn SysFreeString(1) {
  ensures arg0.@allocated = Alloc.FREED
}

# CoTaskMem
fn CoTaskMemAlloc(1) {
  ensures result.@allocated = Alloc.ALLOCATED when result._nonnull != 0
  scope_exit result.@allocated == Alloc.FREED when result._nonnull != 0
}

fn CoTaskMemFree(1) {
  ensures arg0.@allocated = Alloc.FREED
}

# LocalAlloc / LocalFree — return NULL on failure
fn LocalAlloc(2) {
  ensures result.@allocated = Alloc.ALLOCATED when result._nonnull != 0
  scope_exit result.@allocated == Alloc.FREED when result._nonnull != 0
}

fn LocalFree(1) {
  ensures arg0.@allocated = Alloc.FREED
}

# GlobalAlloc / GlobalFree — return NULL on failure
fn GlobalAlloc(2) {
  ensures result.@allocated = Alloc.ALLOCATED when result._nonnull != 0
  scope_exit result.@allocated == Alloc.FREED when result._nonnull != 0
}

fn GlobalFree(1) {
  ensures arg0.@allocated = Alloc.FREED
}

# =========================================================================
# SafeArray lifecycle — return NULL on failure
# =========================================================================

fn SafeArrayCreate(3) {
  ensures result.@safearray = SafeArr.VALID when result._nonnull != 0
  scope_exit result.@safearray == SafeArr.DESTROYED when result._nonnull != 0
}

fn SafeArrayCreateVector(3) {
  ensures result.@safearray = SafeArr.VALID when result._nonnull != 0
  scope_exit result.@safearray == SafeArr.DESTROYED when result._nonnull != 0
}

fn SafeArrayDestroy(1) {
  requires arg0._nonnull != 0 "SAFEARRAY may be invalid or already destroyed"
  ensures arg0.@safearray = SafeArr.DESTROYED
  ensures arg0._nonnull = 0
}
