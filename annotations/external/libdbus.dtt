# =============================================================================
# DTT Annotations: libdbus (D-Bus Reference Implementation)
# =============================================================================
#
# Library: libdbus-1 (1.14.x / 1.15.x)
# Header:  <dbus/dbus.h>
#
# Security context:
#   CVE-2020-35512 - Use-after-free in _dbus_list_unlink
#   CVE-2020-12049 - File descriptor leak in _dbus_read_socket_with_unix_fds
#   CVE-2022-42010 - Bounds read in _dbus_validate_body_with_reason
#   CVE-2022-42011 - Bounds read in dbus_signature_validate
#   CVE-2022-42012 - Use-after-free via message fd passing
#
# Ghost fields:
#   @conn_state: 0 = invalid/freed, 1 = open/connected, 2 = closed/disconnected
#   @conn_type:  1 = shared (bus-managed), 2 = private (caller-managed)
#   @msg_alive:  0 = freed/unreferenced, 1 = alive/valid
#   @server_state: 0 = freed, 1 = listening, 2 = disconnected
#
# Lifecycle patterns:
#   Shared conn:  dbus_bus_get          -> dbus_connection_unref
#   Private conn: dbus_bus_get_private  -> dbus_connection_close + unref
#   Message:      dbus_message_new_*    -> dbus_message_unref
#   Server:       dbus_server_listen    -> dbus_server_disconnect + unref
#
# Key ownership rules:
#   - Shared connections: managed by libdbus, just unref when done
#   - Private connections: MUST call dbus_connection_close() before unref
#   - Messages: ref-counted, unref to release
#   - Pending calls: ref-counted, unref to release
#
# All pointer arguments require _nonnull != 0 unless noted otherwise.
# =============================================================================

