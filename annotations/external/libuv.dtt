# =============================================================================
# DTT Annotations: libuv (Cross-platform Asynchronous I/O)
# =============================================================================
#
# Library: libuv 1.x
# Header:  <uv.h>
#
# Security context:
#   CVE-2024-24806 - Improper domain lookup in uv_getaddrinfo()
#   CVE-2021-22918 - Out-of-bounds read in uv__idna_toascii()
#   CVE-2020-8252  - Buffer overflow in fs.realpath (libuv)
#
# Ghost fields:
#   @loop_state:   0 = freed/uninitialized, 1 = initialized/stopped, 2 = running, 3 = closed
#   @handle_state: 0 = freed/uninitialized, 1 = initialized, 2 = active, 3 = closing, 4 = closed
#
# Key invariant:
#   All handles MUST be closed with uv_close() before the loop is closed with
#   uv_loop_close(). Failure to do so causes undefined behavior / resource leaks.
#
# Lifecycle patterns:
#   Loop:   uv_loop_init -> uv_run -> ... -> uv_loop_close
#   Handle: uv_*_init    -> uv_*_start/bind/connect -> ... -> uv_close (callback) -> free
#   FS req: uv_fs_*      -> ... -> uv_fs_req_cleanup
#
# All handle/loop pointer arguments require _nonnull != 0.
# Loop arguments additionally require @loop_state == 1 (initialized/stopped).
# =============================================================================

# ---------------------------------------------------------------------------
# Event loop lifecycle
# ---------------------------------------------------------------------------

# int uv_loop_init(uv_loop_t *loop)
fn uv_loop_init(1) {
  requires arg0._nonnull != 0
  ensures arg0.@loop_state = 1
}

# int uv_loop_close(uv_loop_t *loop)
fn uv_loop_close(1) {
  requires arg0._nonnull != 0
  requires arg0.@loop_state == 1
  ensures arg0.@loop_state = 3
}

# uv_loop_t *uv_default_loop(void)
fn uv_default_loop(0) {
  ensures result.@loop_state = 1 when result._nonnull != 0
}

# int uv_loop_alive(const uv_loop_t *loop)
fn uv_loop_alive(1) {
  requires arg0._nonnull != 0
  requires arg0.@loop_state == 1
}

# int uv_run(uv_loop_t *loop, uv_run_mode mode)
fn uv_run(2) {
  requires arg0._nonnull != 0
  requires arg0.@loop_state == 1
}

# void uv_stop(uv_loop_t *loop)
