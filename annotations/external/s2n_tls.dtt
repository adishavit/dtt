# s2n-tls Annotations for DTT
#
# Complements s2n's existing formal verification (SAW/Cryptol) at the API
# boundary.  SAW proves correctness of internal crypto primitives; these
# annotations catch caller-side API misuse that formal verification does
# not address: leaked configs, null connections, out-of-order state
# transitions, and missing cleanup.
#
# Ghost-field encoding
# --------------------
# @conn_state:   0=freed 1=created 2=configured 3=negotiated 4=shutdown 5=wiped
# @config_alive: 0=freed 1=alive
# @config_bound: 0=not bound 1=bound to a connection
# @cert_alive:   0=freed 1=alive
#
# CVEs / issues prevented
# -----------------------
# GHSA-q4mv  – memory leak on config (caught by scope_exit @config_alive)
# GHSA-mm47  – NULL-pointer dereference (caught by _nonnull preconditions)
# Issue #4752 – missing null check before use
# Issue #3525 – leaked connection on error path
# Issue #5044 – leaked cert chain

# =========================================================================
# Process-level init / cleanup
# =========================================================================

fn s2n_init(0) {
}

fn s2n_cleanup(0) {
}

fn s2n_cleanup_final(0) {
}

# =========================================================================
# Config lifecycle
# =========================================================================

fn s2n_config_new(0) {
  ensures result.@config_alive = 1 when result._nonnull != 0
  ensures result.@config_bound = 0 when result._nonnull != 0
  scope_exit result.@config_alive == 0 when result._nonnull != 0
}

fn s2n_config_new_minimal(0) {
  ensures result.@config_alive = 1 when result._nonnull != 0
  ensures result.@config_bound = 0 when result._nonnull != 0
  scope_exit result.@config_alive == 0 when result._nonnull != 0
}

fn s2n_config_free(1) {
  requires arg0._nonnull != 0 "config is null"
  requires arg0.@config_alive != 0 "config already freed"
  ensures arg0.@config_alive = 0
}

