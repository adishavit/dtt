# =========================================================================
# Connection lifecycle
# =========================================================================

fn s2n_connection_new(1) {
  ensures result.@conn_state = 1 when result._nonnull != 0
  scope_exit result.@conn_state == 0 when result._nonnull != 0
}

fn s2n_connection_set_config(2) {
  requires arg0._nonnull != 0 "connection is null"
  requires arg0.@conn_state == 1 "connection not in created state"
  requires arg1._nonnull != 0 "config is null"
  requires arg1.@config_alive != 0 "config freed"
  ensures arg1.@config_bound = 1
}

fn s2n_connection_set_fd(2) {
  requires arg0._nonnull != 0
  requires arg0.@conn_state == 1 "connection not in created state"
  ensures arg0.@conn_state = 2
}

fn s2n_connection_set_read_fd(2) {
  requires arg0._nonnull != 0
  requires arg0.@conn_state == 1
}

fn s2n_connection_set_write_fd(2) {
