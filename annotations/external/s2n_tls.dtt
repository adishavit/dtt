# =========================================================================
# Shutdown / teardown
# =========================================================================

fn s2n_shutdown(2) {
  requires arg0._nonnull != 0 "connection is null"
  requires arg0.@conn_state == 3 "connection not negotiated"
  ensures arg0.@conn_state = 4
}

fn s2n_shutdown_send(2) {
  requires arg0._nonnull != 0
  requires arg0.@conn_state == 3
}

fn s2n_connection_wipe(1) {
  requires arg0._nonnull != 0
  ensures arg0.@conn_state = 5
}

fn s2n_connection_free(1) {
  requires arg0._nonnull != 0 "connection is null"
  requires arg0.@conn_state != 0 "connection already freed"
  ensures arg0.@conn_state = 0
}

fn s2n_connection_free_handshake(1) {
  requires arg0._nonnull != 0
  requires arg0.@conn_state == 3
}

fn s2n_connection_release_buffers(1) {
  requires arg0._nonnull != 0
}

