# libarchive Annotations for DTT
#
# Tracks archive read/write lifecycle, disk read/write lifecycle,
# entry lifecycle, and data access safety.
#
# @archive_state:
#   0 = freed/invalid
#   1 = new (after archive_read_new / archive_write_new)
#   2 = configured (after support/format/filter setup)
#   3 = open (after archive_*_open_*)
#   4 = header_read (after archive_read_next_header)
#   -1 = closed (after archive_*_close) — below 3, so "requires >= 3" excludes it
#
# @entry_alive:
#   0 = freed/invalid
#   1 = alive (after archive_entry_new)
#
# CVEs addressed:
#   CVE-2021-36976 - use-after-free in copy_string
#   CVE-2025-25724 - buffer overflow in archive processing
#   RAR decoder double-free issues
#   Lifecycle violations (reading from unopened/closed archives)

# =========================================================================
# Archive Read lifecycle
# =========================================================================

fn archive_read_new(0) {
  ensures result.@archive_state = 1 when result._nonnull != 0
  scope_exit result.@archive_state == 0 when result._nonnull != 0
}

