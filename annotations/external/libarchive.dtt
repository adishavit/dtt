# =========================================================================
# Archive Entry lifecycle
# =========================================================================

fn archive_entry_new(0) {
  ensures result.@entry_alive = 1 when result._nonnull != 0
  scope_exit result.@entry_alive == 0 when result._nonnull != 0
}

fn archive_entry_new2(1) {
  ensures result.@entry_alive = 1 when result._nonnull != 0
  scope_exit result.@entry_alive == 0 when result._nonnull != 0
}

fn archive_entry_clone(1) {
  requires arg0._nonnull != 0 "entry pointer is null"
  requires arg0.@entry_alive != 0 "entry already freed (CVE-2021-36976: use-after-free)"
  ensures result.@entry_alive = 1 when result._nonnull != 0
  scope_exit result.@entry_alive == 0 when result._nonnull != 0
}

fn archive_entry_clear(1) {
  requires arg0._nonnull != 0 "entry pointer is null"
  requires arg0.@entry_alive != 0 "entry already freed"
}

fn archive_entry_free(1) {
  requires arg0._nonnull != 0 "entry pointer is null"
  requires arg0.@entry_alive != 0 "double-free on archive entry"
  ensures arg0.@entry_alive = 0
}

