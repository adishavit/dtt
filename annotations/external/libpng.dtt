# =============================================================================
# DTT Annotations: libpng (PNG Reference Library)
# =============================================================================
#
# Library: libpng 1.6.x
# Header:  <png.h>
#
# Security context:
#   CVE-2026-25646 - Buffer overflow in progressive row reading
#   CVE-2015-8126 - Buffer overflow in png_set_PLTE / png_get_PLTE
#   CVE-2018-13785 - Integer overflow in png_image_begin_read
#   CVE-2019-7317 - Use-after-free in png_image_free
#
# Ghost fields:
#   @png_state: 0 = destroyed/invalid, 1 = created/valid
#
# Lifecycle patterns:
#   Read:  png_create_read_struct  -> ... -> png_destroy_read_struct
#   Write: png_create_write_struct -> ... -> png_destroy_write_struct
#   Info:  png_create_info_struct  -> ... -> png_destroy_info_struct
#
# All pointer arguments require _nonnull != 0 unless noted otherwise.
# =============================================================================

# ---------------------------------------------------------------------------
# Read struct lifecycle
# ---------------------------------------------------------------------------

# png_structp png_create_read_struct(const char *ver, void *err_ptr,
#                                     png_error_ptr err_fn, png_error_ptr warn_fn)
function png_create_read_struct
  arity 4
  pre arg0._nonnull != 0
  post result.@png_state == 1
  post result._nonnull != 0
  scope_exit result.@png_state == 0

# void png_destroy_read_struct(png_structpp ptr, png_infopp info, png_infopp end)
function png_destroy_read_struct
  arity 3
  pre arg0._nonnull != 0
  pre arg0.deref.@png_state == 1
  post arg0.deref.@png_state == 0

# ---------------------------------------------------------------------------
# Write struct lifecycle
# ---------------------------------------------------------------------------

# png_structp png_create_write_struct(const char *ver, void *err_ptr,
#                                      png_error_ptr err_fn, png_error_ptr warn_fn)
function png_create_write_struct
  arity 4
  pre arg0._nonnull != 0
  post result.@png_state == 1
  post result._nonnull != 0
  scope_exit result.@png_state == 0

# void png_destroy_write_struct(png_structpp ptr, png_infopp info)
function png_destroy_write_struct
  arity 2
  pre arg0._nonnull != 0
  pre arg0.deref.@png_state == 1
  post arg0.deref.@png_state == 0

# ---------------------------------------------------------------------------
# Info struct lifecycle
# ---------------------------------------------------------------------------

# png_infop png_create_info_struct(png_const_structrp png_ptr)
function png_create_info_struct
  arity 1
  pre arg0._nonnull != 0
  pre arg0.@png_state == 1
  post result.@png_state == 1
  post result._nonnull != 0

# void png_destroy_info_struct(png_const_structrp png_ptr, png_infopp info)
function png_destroy_info_struct
  arity 2
  pre arg0._nonnull != 0
  pre arg0.@png_state == 1
  pre arg1._nonnull != 0
  post arg1.deref.@png_state == 0

