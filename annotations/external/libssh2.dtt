# libssh2 Annotations for DTT
#
# Tracks session lifecycle, channel lifecycle, SFTP subsystem,
# and known-hosts management.
#
# @session_state:
#   0 = freed/invalid
#   1 = initialized (after libssh2_session_init)
#   2 = handshake complete (after libssh2_session_handshake)
#   3 = authenticated (after libssh2_userauth_*)
#   4 = disconnected (after libssh2_session_disconnect)
#
# CVEs addressed (11 of 14 preventable):
#   CVE-2019-3855/3856/3857/3863/13115/17498 - integer overflow
#   CVE-2019-3858/3859/3860/3861/3862 - out-of-bounds read/write
#   CVE-2020-22218 - uninitialized value
#   Double-free issues (#367, #435, #1549)

# =========================================================================
# Global init/cleanup
# =========================================================================

fn libssh2_init(1) {
}

fn libssh2_exit(0) {
}

# =========================================================================
# Session lifecycle
# =========================================================================

fn libssh2_session_init(0) {
  ensures result.@session_state = 1
  scope_exit result.@session_state == 0
}

fn libssh2_session_init_ex(4) {
  ensures result.@session_state = 1
  scope_exit result.@session_state == 0
}

fn libssh2_session_handshake(2) {
  requires arg0._nonnull != 0 "session is null"
  requires arg0.@session_state == 1 "session not initialized or already handshaken"
  ensures arg0.@session_state = 2
}

fn libssh2_session_startup(2) {
  requires arg0._nonnull != 0 "session is null"
  requires arg0.@session_state == 1
  ensures arg0.@session_state = 2
}

fn libssh2_session_disconnect(1) {
  requires arg0._nonnull != 0 "session is null"
  ensures arg0.@session_state = 4
}

fn libssh2_session_disconnect_ex(3) {
  requires arg0._nonnull != 0 "session is null"
  ensures arg0.@session_state = 4
}

fn libssh2_session_free(1) {
  requires arg0._nonnull != 0 "session is null"
  ensures arg0.@session_state = 0
}

# =========================================================================
# Authentication — requires handshake complete
# =========================================================================

fn libssh2_userauth_password(3) {
  requires arg0._nonnull != 0
  requires arg0.@session_state == 2 "handshake not complete"
  ensures arg0.@session_state = 3
}

fn libssh2_userauth_password_ex(5) {
  requires arg0._nonnull != 0
  requires arg0.@session_state == 2
  ensures arg0.@session_state = 3
}

fn libssh2_userauth_publickey_fromfile(4) {
  requires arg0._nonnull != 0
  requires arg0.@session_state == 2
  ensures arg0.@session_state = 3
}

fn libssh2_userauth_publickey_fromfile_ex(6) {
  requires arg0._nonnull != 0
  requires arg0.@session_state == 2
  ensures arg0.@session_state = 3
}

fn libssh2_userauth_publickey_frommemory(6) {
  requires arg0._nonnull != 0
  requires arg0.@session_state == 2
  ensures arg0.@session_state = 3
}

fn libssh2_userauth_keyboard_interactive(3) {
  requires arg0._nonnull != 0
  requires arg0.@session_state == 2
  ensures arg0.@session_state = 3
}

fn libssh2_userauth_authenticated(1) {
  requires arg0._nonnull != 0
}

fn libssh2_userauth_list(3) {
  requires arg0._nonnull != 0
  requires arg0.@session_state == 2 "handshake not complete"
}

