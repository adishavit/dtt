# =============================================================================
# DTT Annotations: zlib (Compression Library)
# =============================================================================
#
# Library: zlib 1.2.x / 1.3.x
# Header:  <zlib.h>
#
# Security context:
#   CVE-2022-37434 - Heap buffer overflow in inflateGetHeader
#   CVE-2023-45853 - Integer overflow in MiniZip in zlib (zipOpenNewFileInZip4_64)
#   CVE-2018-25032 - Memory corruption in deflate (certain input patterns)
#
# Ghost fields:
#   @stream_state: 0 = uninitialized/ended, 1 = deflate active, 2 = inflate active
#   @gz_open:      0 = closed, 1 = open
#
# Lifecycle patterns:
#   Deflate: deflateInit -> deflate* -> deflateEnd
#   Inflate: inflateInit -> inflate* -> inflateEnd
#   Gzip:    gzopen      -> gz*      -> gzclose
#
# All pointer arguments require _nonnull != 0 unless noted otherwise.
# =============================================================================

# ---------------------------------------------------------------------------
# Deflate lifecycle
# ---------------------------------------------------------------------------

# int deflateInit(z_streamp strm, int level)
# (macro expanding to deflateInit_(strm, level, version, stream_size))
function deflateInit
  arity 2
  pre arg0._nonnull != 0
  post arg0.@stream_state == 1
  scope_exit arg0.@stream_state == 0

# int deflateInit2(z_streamp strm, int level, int method, int windowBits,
#                   int memLevel, int strategy)
function deflateInit2
  arity 6
  pre arg0._nonnull != 0
  post arg0.@stream_state == 1
  scope_exit arg0.@stream_state == 0

# int deflateInit_(z_streamp strm, int level, const char *version, int stream_size)
function deflateInit_
  arity 4
  pre arg0._nonnull != 0
  pre arg2._nonnull != 0
  post arg0.@stream_state == 1
  scope_exit arg0.@stream_state == 0

# int deflateInit2_(z_streamp strm, int level, int method, int windowBits,
#                    int memLevel, int strategy, const char *version, int stream_size)
function deflateInit2_
  arity 8
  pre arg0._nonnull != 0
  pre arg6._nonnull != 0
  post arg0.@stream_state == 1
  scope_exit arg0.@stream_state == 0

# int deflate(z_streamp strm, int flush)
function deflate
  arity 2
  pre arg0._nonnull != 0
  pre arg0.@stream_state == 1

# int deflateEnd(z_streamp strm)
function deflateEnd
  arity 1
  pre arg0._nonnull != 0
  pre arg0.@stream_state == 1
  post arg0.@stream_state == 0

# int deflateReset(z_streamp strm)
function deflateReset
  arity 1
  pre arg0._nonnull != 0
  pre arg0.@stream_state == 1
  post arg0.@stream_state == 1

# int deflateCopy(z_streamp dest, z_streamp source)
function deflateCopy
  arity 2
  pre arg0._nonnull != 0
  pre arg1._nonnull != 0
  pre arg1.@stream_state == 1
  post arg0.@stream_state == 1
  scope_exit arg0.@stream_state == 0

# int deflateSetDictionary(z_streamp strm, const Bytef *dictionary,
#                           uInt dictLength)
function deflateSetDictionary
  arity 3
  pre arg0._nonnull != 0
  pre arg0.@stream_state == 1
  pre arg1._nonnull != 0

# int deflateParams(z_streamp strm, int level, int strategy)
function deflateParams
  arity 3
  pre arg0._nonnull != 0
  pre arg0.@stream_state == 1

