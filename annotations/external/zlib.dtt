# gzFile gzopen(const char *path, const char *mode)
fn gzopen(2) {
  requires arg0._nonnull != 0
  requires arg1._nonnull != 0
  ensures result.@gz_open = 1 when result._nonnull != 0
  scope_exit result.@gz_open == 0 when result._nonnull != 0
}

