# =============================================================================
# DTT Annotations: FFmpeg (libavformat, libavcodec, libavutil, libswscale, libswresample, libavfilter)
# =============================================================================
#
# Library: FFmpeg 6.x / 7.x
# Headers: <libavformat/avformat.h>, <libavcodec/avcodec.h>, <libavutil/frame.h>,
#          <libswscale/swscale.h>, <libswresample/swresample.h>,
#          <libavfilter/avfilter.h>, <libavutil/dict.h>, <libavutil/opt.h>
#
# Security context:
#   CVE-2024-7055  - Heap buffer overflow in pnm_decode_frame
#   CVE-2024-32230 - Buffer overflow in FFmpeg via av_strlcpy (build_table_from_list)
#   CVE in pthread_frame.c - Use-after-free in frame threading
#   CVE-2024-22860 - Buffer overflow in ffmpeg's fill_audiodata
#   CVE-2023-51793 - Heap buffer overflow in dec_open
#
# Ghost fields:
#   @format_state: 0 = freed, 1 = allocated, 2 = open (input opened), 3 = streams found
#   @codec_state:  0 = freed, 1 = allocated, 2 = open (codec opened)
#   @packet_alive: 0 = freed, 1 = alive/allocated
#   @frame_alive:  0 = freed, 1 = alive/allocated
#   @sws_alive:    0 = freed, 1 = alive
#   @swr_alive:    0 = freed, 1 = alive/allocated, 2 = initialized
#   @filter_alive: 0 = freed, 1 = alive/configured
#   @avio_open:    0 = closed, 1 = open
#
# Lifecycle patterns:
#   Input format:  avformat_alloc_context -> avformat_open_input -> find_stream_info -> ... -> avformat_close_input
#   Output format: avformat_alloc_output_context2 -> new_stream -> write_header -> ... -> write_trailer -> free
#   Codec:         avcodec_alloc_context3 -> parameters_to_context -> avcodec_open2 -> send/receive -> avcodec_free_context
#   Packet:        av_packet_alloc -> ... -> av_packet_free
#   Frame:         av_frame_alloc  -> ... -> av_frame_free
#   SwScale:       sws_getContext  -> sws_scale -> sws_freeContext
#   SwResample:    swr_alloc -> swr_init -> swr_convert -> swr_free
#   Filter:        avfilter_graph_alloc -> config -> ... -> avfilter_graph_free
#
# All pointer arguments require _nonnull != 0 unless noted otherwise.
# =============================================================================

