# Test annotation file for named enumeration support (Gap 5)
#
# Enums map symbolic names to integer constants, making .dtt files
# more readable and less error-prone than raw magic numbers.

enum Capacity {
  EMPTY = 0
  SMALL = 1
  LARGE = 10
}

trait EnumPushBack {
  push_back(1):
    ensures _size = old(_size) + 1
}

# Type using enum constants in requires, ensures, and ensures_if_*
type EnumBuf : EnumPushBack {
  @ctor(0):
    ensures _size = Capacity.EMPTY

  # Enum in ensures (SymValue)
  fill_small(0):
    ensures _size = Capacity.SMALL

  fill_large(0):
    ensures _size = Capacity.LARGE

  # Enum in requires (ConstraintExpr)
  get(1):
    requires _size != Capacity.EMPTY
    requires arg0 < _size

  # Enum in ensures_if_true / ensures_if_false
  is_empty(0):
    ensures_if_true _size == Capacity.EMPTY
    ensures_if_false _size > Capacity.EMPTY
}

# Free function using enum in requires and ensures
enum FileState {
  CLOSED = 0
  OPEN = 1
}

fn enum_fopen(1) {
  ensures result.@eopen = FileState.OPEN
  scope_exit result.@eopen == FileState.CLOSED
}

fn enum_fclose(1) {
  requires arg0.@eopen != FileState.CLOSED "file already closed"
  ensures arg0.@eopen = FileState.CLOSED
}
