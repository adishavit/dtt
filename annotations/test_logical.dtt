# Test annotation file for logical operator parsing (&&, ||)

trait TestPushBack {
  push_back(1):
    ensures _size = old(_size) + 1
}

# Type with compound preconditions using && and ||
type RangeBuffer : TestPushBack {
  @ctor(0):
    ensures _size = 0

  # Compound &&: container must be non-empty AND index in bounds
  safe_get(1):
    requires _size > 0 && arg0 < _size

  # Compound ||: at least one way to be valid
  check_or(1):
    requires _size > 0 || arg0 == 0
}
