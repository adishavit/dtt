# C Library Function Annotations for DTT
# All C library semantic annotations in declarative form.

# =========================================================================
# Named enumerations — replace magic 0/1 with readable constants
# =========================================================================

# FILE*, file descriptors, directory streams, dynamic libraries
enum FileIO {
  CLOSED = 0
  OPEN = 1
}

# malloc/calloc/realloc, mmap
enum Alloc {
  FREED = 0
  ALLOCATED = 1
}

# Semaphores, message queues, shared memory, iconv, regex, addrinfo, pthread
enum InitState {
  DESTROYED = 0
  INITIALIZED = 1
}

# =========================================================================
# FILE I/O - null tracking
# =========================================================================

# FILE* as arg0 (single-arg, multi-arg, and variadic)
fn fgetc(1), getc(1), ftell(1), rewind(1), fflush(1),
   feof(1), ferror(1), clearerr(1), fileno(1), ftello(1),
   fseek(3), fseeko(3), fgetpos(2), fsetpos(2), setvbuf(4), setbuf(2),
   fprintf(2..6), fscanf(2..6), vfprintf(2..6), vfscanf(2..6),
   fwprintf(2..6), fwscanf(2..6) {
  requires arg0._nonnull != 0 "FILE* may be null (fopen can fail)"
}

# FILE* as arg1
fn fputc(2), putc(2), fputs(2), ungetc(2) {
  requires arg1._nonnull != 0 "FILE* may be null (fopen can fail)"
}

# fgets: FILE* is arg2
fn fgets(3) {
  requires arg2._nonnull != 0 "FILE* may be null (fopen can fail)"
}

# fread: FILE* is arg3, requires _readable
fn fread(4) {
  requires arg3._nonnull != 0 "FILE* may be null (fopen can fail)"
  requires arg3._readable != 0 "FILE* not opened for reading"
}

# fwrite: FILE* is arg3, requires _writable
fn fwrite(4) {
  requires arg3._nonnull != 0 "FILE* may be null (fopen can fail)"
  requires arg3._writable != 0 "FILE* not opened for writing"
}

# =========================================================================
# RESOURCE TRACKING - FILE I/O (@open ghost field)
# =========================================================================

fn fopen(2), tmpfile(0), popen(2) {
  ensures result.@open = FileIO.OPEN when result._nonnull != 0
  scope_exit result.@open == FileIO.CLOSED when result._nonnull != 0
}

# freopen: closes arg2 internally, returns new (or same) stream.
# No scope_exit: freopen on stdout/stderr is a common idiom where
# the result is deliberately not closed.
fn freopen(3) {
  ensures arg2.@open = FileIO.CLOSED
  ensures result.@open = FileIO.OPEN when result._nonnull != 0
}

# fdopen: consumes the fd, opens a FILE* stream
fn fdopen(2) {
  ensures result.@open = FileIO.OPEN when result._nonnull != 0
  ensures arg0.@fd = FileIO.CLOSED
  scope_exit result.@open == FileIO.CLOSED when result._nonnull != 0
}

fn fclose(1), pclose(1) {
  requires arg0._nonnull != 0 "FILE* may be null or already closed"
  ensures arg0.@open = FileIO.CLOSED
  ensures arg0._nonnull = 0
}

# =========================================================================
# RESOURCE TRACKING - Memory allocation (@allocated ghost field)
# =========================================================================

fn malloc(1), calloc(2), realloc(2), aligned_alloc(2),
   strdup(1), strndup(2) {
  ensures result.@allocated = Alloc.ALLOCATED when result._nonnull != 0
  scope_exit result.@allocated == Alloc.FREED when result._nonnull != 0
}

fn free(1) {
  ensures arg0.@allocated = Alloc.FREED
}

# =========================================================================
# RESOURCE TRACKING - POSIX file descriptors (@fd ghost field)
# =========================================================================

fn open(2), open(3), openat(3), openat(4), creat(2),
   dup(1), dup2(2), dup3(3), pipe(1), socket(3),
   accept(3), accept4(4), mkstemp(1),
   epoll_create(1), epoll_create1(1) {
  ensures result.@fd = FileIO.OPEN when result._value >= 0
  scope_exit result.@fd == FileIO.CLOSED when result._value >= 0
}

fn close(1) {
  ensures arg0.@fd = FileIO.CLOSED
}

# =========================================================================
# RESOURCE TRACKING - Directory streams (@dir ghost field)
# =========================================================================

fn opendir(1), fdopendir(1) {
  ensures result.@dir = FileIO.OPEN when result._nonnull != 0
  scope_exit result.@dir == FileIO.CLOSED when result._nonnull != 0
}

fn closedir(1) {
  ensures arg0.@dir = FileIO.CLOSED
}

# DIR* operations - null check
fn readdir(1), telldir(1), rewinddir(1), seekdir(2) {
  requires arg0._nonnull != 0 "DIR* may be null (opendir can fail)"
}

# =========================================================================
# RESOURCE TRACKING - Dynamic libraries (@dl ghost field)
# =========================================================================

fn dlopen(2) {
  ensures result.@dl = FileIO.OPEN when result._nonnull != 0
  scope_exit result.@dl == FileIO.CLOSED when result._nonnull != 0
}

fn dlclose(1) {
  ensures arg0.@dl = FileIO.CLOSED
}

# =========================================================================
# RESOURCE TRACKING - Memory mapping (@mapped ghost field)
# =========================================================================

fn mmap(6) {
  ensures result.@mapped = Alloc.ALLOCATED
  scope_exit result.@mapped == Alloc.FREED
}

fn munmap(2) {
  ensures arg0.@mapped = Alloc.FREED
}

# =========================================================================
# RESOURCE TRACKING - POSIX semaphores (@sem ghost field)
# =========================================================================

fn sem_open(2), sem_open(4) {
  ensures result.@sem = InitState.INITIALIZED
  scope_exit result.@sem == InitState.DESTROYED
}

fn sem_close(1) {
  ensures arg0.@sem = InitState.DESTROYED
}

# =========================================================================
# RESOURCE TRACKING - POSIX message queues (@mq ghost field)
# =========================================================================

fn mq_open(2), mq_open(4) {
  ensures result.@mq = InitState.INITIALIZED
  scope_exit result.@mq == InitState.DESTROYED
}

fn mq_close(1) {
  ensures arg0.@mq = InitState.DESTROYED
}

# =========================================================================
# RESOURCE TRACKING - POSIX shared memory (@shm ghost field)
# =========================================================================

fn shm_open(3) {
  ensures result.@shm = InitState.INITIALIZED
  scope_exit result.@shm == InitState.DESTROYED
}

# =========================================================================
# RESOURCE TRACKING - iconv (@iconv ghost field)
# =========================================================================

fn iconv_open(2) {
  ensures result.@iconv = InitState.INITIALIZED
  scope_exit result.@iconv == InitState.DESTROYED
}

fn iconv_close(1) {
  ensures arg0.@iconv = InitState.DESTROYED
}

# =========================================================================
# RESOURCE TRACKING - POSIX regex (@regex ghost field)
# =========================================================================

fn regcomp(3) {
  ensures arg0.@regex = InitState.INITIALIZED
}

fn regfree(1) {
  ensures arg0.@regex = InitState.DESTROYED
}

# =========================================================================
# RESOURCE TRACKING - getaddrinfo (@addrinfo ghost field)
# =========================================================================

fn getaddrinfo(4) {
  ensures arg3.@addrinfo = InitState.INITIALIZED
}

fn freeaddrinfo(1) {
  ensures arg0.@addrinfo = InitState.DESTROYED
}

# =========================================================================
# RESOURCE TRACKING - pthread synchronization
# =========================================================================

fn pthread_mutex_init(2) {
  ensures arg0.@mutex = InitState.INITIALIZED
}

fn pthread_mutex_destroy(1) {
  ensures arg0.@mutex = InitState.DESTROYED
}

fn pthread_cond_init(2) {
  ensures arg0.@cond = InitState.INITIALIZED
}

fn pthread_cond_destroy(1) {
  ensures arg0.@cond = InitState.DESTROYED
}

fn pthread_rwlock_init(2) {
  ensures arg0.@rwlock = InitState.INITIALIZED
}

fn pthread_rwlock_destroy(1) {
  ensures arg0.@rwlock = InitState.DESTROYED
}

# =========================================================================
# STRING EXAMINATION - null pointer checks
# =========================================================================

# arg0 only
fn strlen(1), strchr(2), strrchr(2) {
  requires arg0._nonnull != 0 "string pointer may be null"
}

# arg0 + arg1
fn strcmp(2), strncmp(3), strstr(2), strpbrk(2), strcspn(2), strspn(2) {
  requires arg0._nonnull != 0 "string pointer may be null"
  requires arg1._nonnull != 0 "string pointer may be null"
}

# =========================================================================
# STRING-TO-NUMBER CONVERSION - null pointer checks
# =========================================================================

fn atoi(1), atol(1), atof(1),
   strtol(3), strtoll(3), strtoul(3), strtoull(3),
   strtof(2), strtod(2), strtold(2) {
  requires arg0._nonnull != 0 "string pointer may be null"
}

# =========================================================================
# OUTPUT - null pointer checks
# =========================================================================

fn puts(1) {
  requires arg0._nonnull != 0 "string pointer may be null"
}

# =========================================================================
# ENVIRONMENT - null pointer checks
# =========================================================================

fn getenv(1) {
  requires arg0._nonnull != 0 "environment variable name may be null"
}

# =========================================================================
# TIME - null pointer checks
# =========================================================================

fn localtime(1), gmtime(1), ctime(1) {
  requires arg0._nonnull != 0 "time_t pointer may be null"
}

fn asctime(1), mktime(1) {
  requires arg0._nonnull != 0 "tm pointer may be null"
}

fn strftime(4) {
  requires arg2._nonnull != 0 "format string may be null"
  requires arg3._nonnull != 0 "tm pointer may be null"
}

# =========================================================================
# TAINT TRACKING - Sources (functions that introduce untrusted data)
# =========================================================================

# Environment (attacker-controlled in many threat models)
# getenv already has a requires for null check above; adding taint here
fn getenv(1) {
  taints result Medium
}

fn secure_getenv(1) {
  taints result Medium
}

# Character input (stdin = direct user input)
fn getchar(0), getchar_unlocked(0) {
  taints result High
}

# Line input (always taints buffer)
fn gets(1) {
  taints arg0 High
  taints result High
}

# Formatted input (taints all variadic output args)
fn scanf(1..6) {
  taints variadic High
}

# System info (local but potentially attacker-influenced)
fn getcwd(2) {
  taints arg0 Low
  taints result Low
}

fn gethostname(2) {
  taints arg0 Low
}

# Symbolic links
fn readlink(3) {
  taints arg1 Low
  taints result Low
}

# File I/O (tainted handle = propagation vehicle)
fn fopen(2) {
  taints result Low
  sink arg0 CWE-22 "tainted value used as file path"
}

fn popen(2) {
  taints result Low
  sink arg0 CWE-78 "tainted value used as shell command"
}

fn fdopen(2) {
  taints result Low
}

# =========================================================================
# TAINT TRACKING - Sinks (dangerous if tainted)
# =========================================================================

# Command injection (CWE-78)
fn system(1) {
  sink arg0 CWE-78 "tainted value used as shell command"
}

fn execl(1..6), execle(1..6), execlp(1..6) {
  sink arg0 CWE-78 "tainted value used as program path"
}

fn execv(2), execve(3), execvp(2), execvpe(3) {
  sink arg0 CWE-78 "tainted value used as program path"
}

# Library injection (CWE-426)
fn dlopen(2) {
  sink arg0 CWE-426 "tainted value used as library path"
}

# Format string attacks (CWE-134) - only FORMAT arg is a sink
fn printf(1..6) {
  sink arg0 CWE-134 "tainted value used as format string"
}

fn fprintf(2..6) {
  sink arg1 CWE-134 "tainted value used as format string"
}

fn sprintf(2..6) {
  sink arg1 CWE-134 "tainted value used as format string"
}

fn snprintf(3..6) {
  sink arg2 CWE-134 "tainted value used as format string"
}

fn syslog(2..6) {
  sink arg1 CWE-134 "tainted value used as format string"
}

# Path traversal (CWE-22) - already on fopen above
fn open(2), open(3) {
  sink arg0 CWE-22 "tainted value used as file path"
}

fn creat(2) {
  sink arg0 CWE-22 "tainted value used as file path"
}

fn openat(3), openat(4) {
  sink arg1 CWE-22 "tainted value used as file path"
}

# Allocation size (CWE-190) - tainted sizes can overflow
fn malloc(1) {
  sink arg0 CWE-190 "tainted value used as allocation size"
}

fn calloc(2) {
  sink arg0 CWE-190 "tainted value used as allocation size"
  sink arg1 CWE-190 "tainted value used as allocation size"
}

fn realloc(2) {
  sink arg1 CWE-190 "tainted value used as allocation size"
}

fn alloca(1) {
  sink arg0 CWE-190 "tainted value used as stack allocation size"
}

# Buffer operation sizes (CWE-120)
fn memcpy(3), memmove(3) {
  sink arg2 CWE-120 "tainted value used as copy length"
  propagates arg1 -> arg0
  propagates arg1 -> result
}

fn memset(3) {
  sink arg2 CWE-120 "tainted value used as fill length"
}

fn strncpy(3) {
  sink arg2 CWE-120 "tainted value used as copy length"
  propagates arg1 -> arg0
  propagates arg1 -> result
}

fn strncat(3) {
  sink arg2 CWE-120 "tainted value used as concat length"
  propagates arg1 -> arg0
  propagates arg1 -> result
}

# =========================================================================
# TAINT TRACKING - Propagators (taint flows through these)
# =========================================================================

# String duplication
fn strdup(1), strndup(2) {
  propagates arg0 -> result
}

# String copy
fn strcpy(2), stpcpy(2) {
  propagates arg1 -> arg0
  propagates arg1 -> result
}

fn strcat(2) {
  propagates arg1 -> arg0
  propagates arg1 -> result
}

# String search (tainted haystack -> tainted result)
fn strstr(2), strchr(2), strrchr(2), strpbrk(2) {
  propagates arg0 -> result
}

fn memchr(3), memrchr(3) {
  propagates arg0 -> result
}

# String comparison (reveals info about tainted content)
fn strcmp(2), strncmp(3), strcasecmp(2), strncasecmp(3) {
  propagates arg0 -> result
  propagates arg1 -> result
}

fn memcmp(3) {
  propagates arg0 -> result
  propagates arg1 -> result
}

# DTT-SPECIFIC: strlen on tainted buffer taints the length
# (Heartbleed attack vector: attacker controls claimed length)
fn strlen(1), strnlen(2) {
  propagates arg0 -> result
}

# Numeric conversion (tainted string -> tainted number)
fn atoi(1), atol(1), atoll(1), atof(1) {
  propagates arg0 -> result
}

fn strtol(3), strtoll(3), strtoul(3), strtoull(3) {
  propagates arg0 -> result
}

fn strtof(2), strtod(2), strtold(2) {
  propagates arg0 -> result
}

# Formatted output (tainted format args -> tainted buffer)
fn sprintf(2..6) {
  propagates variadic -> arg0
}

fn snprintf(3..6) {
  propagates variadic -> arg0
}

# Character operations
fn tolower(1), toupper(1) {
  propagates arg0 -> result
}

# Path operations
fn basename(1), dirname(1) {
  propagates arg0 -> result
}

fn realpath(2) {
  propagates arg0 -> arg1
  propagates arg0 -> result
}

# Realloc preserves taint of original data
fn realloc(2) {
  propagates arg0 -> result
}

# File/fd I/O (tainted FILE* taints buffer)
fn fread(4) {
  propagates arg3 -> arg0
  propagates arg3 -> result
}

fn fgets(3) {
  propagates arg2 -> arg0
  propagates arg2 -> result
}

fn fgetc(1), getc(1) {
  propagates arg0 -> result
}

# sscanf (tainted source string -> tainted output args)
fn sscanf(2..6) {
  propagates arg0 -> variadic
}
