# =========================================================================
# RESOURCE TRACKING - pthread synchronization
# =========================================================================

fn pthread_mutex_init(2) {
  ensures arg0.@mutex = InitState.INITIALIZED
}

fn pthread_mutex_destroy(1) {
  ensures arg0.@mutex = InitState.DESTROYED
}

fn pthread_cond_init(2) {
  ensures arg0.@cond = InitState.INITIALIZED
}

fn pthread_cond_destroy(1) {
  ensures arg0.@cond = InitState.DESTROYED
}

fn pthread_rwlock_init(2) {
  ensures arg0.@rwlock = InitState.INITIALIZED
}

fn pthread_rwlock_destroy(1) {
  ensures arg0.@rwlock = InitState.DESTROYED
}

# =========================================================================
# STRING EXAMINATION - null pointer checks
# =========================================================================

fn strlen(1) {
  requires arg0._nonnull != 0 "string pointer may be null"
}

fn strcmp(2) {
  requires arg0._nonnull != 0 "string pointer may be null"
  requires arg1._nonnull != 0 "string pointer may be null"
}

fn strncmp(3) {
  requires arg0._nonnull != 0 "string pointer may be null"
  requires arg1._nonnull != 0 "string pointer may be null"
}

