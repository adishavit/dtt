# C Library Function Annotations for DTT
# All C library semantic annotations in declarative form.

# =========================================================================
# Named enumerations — replace magic 0/1 with readable constants
# =========================================================================

# FILE*, file descriptors, directory streams, dynamic libraries
enum FileIO {
  CLOSED = 0
  OPEN = 1
}

# malloc/calloc/realloc, mmap
enum Alloc {
  FREED = 0
  ALLOCATED = 1
}

# Semaphores, message queues, shared memory, iconv, regex, addrinfo, pthread
enum InitState {
  DESTROYED = 0
  INITIALIZED = 1
}

# =========================================================================
# FILE I/O - null tracking
# =========================================================================

# Functions with FILE* as first argument (1 arg total)
fn fgetc(1) {
  requires arg0._nonnull != 0 "FILE* may be null (fopen can fail)"
}

fn getc(1) {
  requires arg0._nonnull != 0 "FILE* may be null (fopen can fail)"
}

fn ftell(1) {
  requires arg0._nonnull != 0 "FILE* may be null (fopen can fail)"
}

fn rewind(1) {
  requires arg0._nonnull != 0 "FILE* may be null (fopen can fail)"
}

fn fflush(1) {
  requires arg0._nonnull != 0 "FILE* may be null (fopen can fail)"
}

fn feof(1) {
  requires arg0._nonnull != 0 "FILE* may be null (fopen can fail)"
}

fn ferror(1) {
  requires arg0._nonnull != 0 "FILE* may be null (fopen can fail)"
}

fn clearerr(1) {
  requires arg0._nonnull != 0 "FILE* may be null (fopen can fail)"
}

fn fileno(1) {
  requires arg0._nonnull != 0 "FILE* may be null (fopen can fail)"
}

fn ftello(1) {
  requires arg0._nonnull != 0 "FILE* may be null (fopen can fail)"
}

# Multi-arg FILE* functions (FILE* as arg0)
fn fseek(3) {
  requires arg0._nonnull != 0 "FILE* may be null (fopen can fail)"
}

fn fseeko(3) {
  requires arg0._nonnull != 0 "FILE* may be null (fopen can fail)"
}

fn fgetpos(2) {
  requires arg0._nonnull != 0 "FILE* may be null (fopen can fail)"
}

fn fsetpos(2) {
  requires arg0._nonnull != 0 "FILE* may be null (fopen can fail)"
}

fn setvbuf(4) {
  requires arg0._nonnull != 0 "FILE* may be null (fopen can fail)"
}

fn setbuf(2) {
  requires arg0._nonnull != 0 "FILE* may be null (fopen can fail)"
}

# Variadic FILE* functions (FILE* as arg0, register arities 2-6)
fn fprintf(2..6) {
  requires arg0._nonnull != 0 "FILE* may be null (fopen can fail)"
}

fn fscanf(2..6) {
  requires arg0._nonnull != 0 "FILE* may be null (fopen can fail)"
}

fn vfprintf(2..6) {
  requires arg0._nonnull != 0 "FILE* may be null (fopen can fail)"
}

fn vfscanf(2..6) {
  requires arg0._nonnull != 0 "FILE* may be null (fopen can fail)"
}

fn fwprintf(2..6) {
  requires arg0._nonnull != 0 "FILE* may be null (fopen can fail)"
}

fn fwscanf(2..6) {
  requires arg0._nonnull != 0 "FILE* may be null (fopen can fail)"
}

# Functions with FILE* as second argument (arg1)
fn fputc(2) {
  requires arg1._nonnull != 0 "FILE* may be null (fopen can fail)"
}

fn putc(2) {
  requires arg1._nonnull != 0 "FILE* may be null (fopen can fail)"
}

fn fputs(2) {
  requires arg1._nonnull != 0 "FILE* may be null (fopen can fail)"
}

fn ungetc(2) {
  requires arg1._nonnull != 0 "FILE* may be null (fopen can fail)"
}

# fgets: FILE* is third argument (arg2)
fn fgets(3) {
  requires arg2._nonnull != 0 "FILE* may be null (fopen can fail)"
}

# fread: FILE* is fourth argument, requires _readable
fn fread(4) {
  requires arg3._nonnull != 0 "FILE* may be null (fopen can fail)"
  requires arg3._readable != 0 "FILE* not opened for reading"
}

# fwrite: FILE* is fourth argument, requires _writable
fn fwrite(4) {
  requires arg3._nonnull != 0 "FILE* may be null (fopen can fail)"
  requires arg3._writable != 0 "FILE* not opened for writing"
}

# =========================================================================
# RESOURCE TRACKING - FILE I/O (@open ghost field)
# =========================================================================

fn fopen(2) {
  ensures result.@open = FileIO.OPEN when result._nonnull != 0
  scope_exit result.@open == FileIO.CLOSED when result._nonnull != 0
}

# freopen: closes arg2 internally, returns new stream
fn freopen(3) {
  ensures result.@open = FileIO.OPEN when result._nonnull != 0
}

fn tmpfile(0) {
  ensures result.@open = FileIO.OPEN when result._nonnull != 0
  scope_exit result.@open == FileIO.CLOSED when result._nonnull != 0
}

fn fdopen(2) {
  ensures result.@open = FileIO.OPEN when result._nonnull != 0
  ensures arg0.@fd = FileIO.CLOSED
  scope_exit result.@open == FileIO.CLOSED when result._nonnull != 0
}

fn popen(2) {
  ensures result.@open = FileIO.OPEN when result._nonnull != 0
  scope_exit result.@open == FileIO.CLOSED when result._nonnull != 0
}

fn fclose(1) {
  requires arg0._nonnull != 0 "FILE* may be null or already closed"
  ensures arg0.@open = FileIO.CLOSED
  ensures arg0._nonnull = 0
}

fn pclose(1) {
  requires arg0._nonnull != 0 "FILE* may be null or already closed"
  ensures arg0.@open = FileIO.CLOSED
  ensures arg0._nonnull = 0
}

# =========================================================================
# RESOURCE TRACKING - Memory allocation (@allocated ghost field)
# =========================================================================

fn malloc(1) {
  ensures result.@allocated = Alloc.ALLOCATED when result._nonnull != 0
  scope_exit result.@allocated == Alloc.FREED when result._nonnull != 0
}

fn calloc(2) {
  ensures result.@allocated = Alloc.ALLOCATED when result._nonnull != 0
  scope_exit result.@allocated == Alloc.FREED when result._nonnull != 0
}

fn realloc(2) {
  ensures result.@allocated = Alloc.ALLOCATED when result._nonnull != 0
  scope_exit result.@allocated == Alloc.FREED when result._nonnull != 0
}

fn aligned_alloc(2) {
  ensures result.@allocated = Alloc.ALLOCATED when result._nonnull != 0
  scope_exit result.@allocated == Alloc.FREED when result._nonnull != 0
}

fn strdup(1) {
  ensures result.@allocated = Alloc.ALLOCATED when result._nonnull != 0
  scope_exit result.@allocated == Alloc.FREED when result._nonnull != 0
}

fn strndup(2) {
  ensures result.@allocated = Alloc.ALLOCATED when result._nonnull != 0
  scope_exit result.@allocated == Alloc.FREED when result._nonnull != 0
}

fn free(1) {
  ensures arg0.@allocated = Alloc.FREED
}

# =========================================================================
# RESOURCE TRACKING - POSIX file descriptors (@fd ghost field)
# =========================================================================

fn open(2) {
  ensures result.@fd = FileIO.OPEN
  scope_exit result.@fd == FileIO.CLOSED
}

fn open(3) {
  ensures result.@fd = FileIO.OPEN
  scope_exit result.@fd == FileIO.CLOSED
}

fn openat(3) {
  ensures result.@fd = FileIO.OPEN
  scope_exit result.@fd == FileIO.CLOSED
}

fn openat(4) {
  ensures result.@fd = FileIO.OPEN
  scope_exit result.@fd == FileIO.CLOSED
}

fn creat(2) {
  ensures result.@fd = FileIO.OPEN
  scope_exit result.@fd == FileIO.CLOSED
}

fn dup(1) {
  ensures result.@fd = FileIO.OPEN
  scope_exit result.@fd == FileIO.CLOSED
}

fn dup2(2) {
  ensures result.@fd = FileIO.OPEN
  scope_exit result.@fd == FileIO.CLOSED
}

fn dup3(3) {
  ensures result.@fd = FileIO.OPEN
  scope_exit result.@fd == FileIO.CLOSED
}

fn pipe(1) {
  ensures result.@fd = FileIO.OPEN
  scope_exit result.@fd == FileIO.CLOSED
}

fn socket(3) {
  ensures result.@fd = FileIO.OPEN
  scope_exit result.@fd == FileIO.CLOSED
}

fn accept(3) {
  ensures result.@fd = FileIO.OPEN
  scope_exit result.@fd == FileIO.CLOSED
}

fn accept4(4) {
  ensures result.@fd = FileIO.OPEN
  scope_exit result.@fd == FileIO.CLOSED
}

fn mkstemp(1) {
  ensures result.@fd = FileIO.OPEN
  scope_exit result.@fd == FileIO.CLOSED
}

fn epoll_create(1) {
  ensures result.@fd = FileIO.OPEN
  scope_exit result.@fd == FileIO.CLOSED
}

fn epoll_create1(1) {
  ensures result.@fd = FileIO.OPEN
  scope_exit result.@fd == FileIO.CLOSED
}

fn close(1) {
  ensures arg0.@fd = FileIO.CLOSED
}

# =========================================================================
# RESOURCE TRACKING - Directory streams (@dir ghost field)
# =========================================================================

fn opendir(1) {
  ensures result.@dir = FileIO.OPEN when result._nonnull != 0
  scope_exit result.@dir == FileIO.CLOSED when result._nonnull != 0
}

fn fdopendir(1) {
  ensures result.@dir = FileIO.OPEN when result._nonnull != 0
  scope_exit result.@dir == FileIO.CLOSED when result._nonnull != 0
}

fn closedir(1) {
  ensures arg0.@dir = FileIO.CLOSED
}

# Directory stream operations - null check for DIR*
fn readdir(1) {
  requires arg0._nonnull != 0 "DIR* may be null (opendir can fail)"
}

fn telldir(1) {
  requires arg0._nonnull != 0 "DIR* may be null (opendir can fail)"
}

fn rewinddir(1) {
  requires arg0._nonnull != 0 "DIR* may be null (opendir can fail)"
}

fn seekdir(2) {
  requires arg0._nonnull != 0 "DIR* may be null (opendir can fail)"
}

# =========================================================================
# RESOURCE TRACKING - Dynamic libraries (@dl ghost field)
# =========================================================================

fn dlopen(2) {
  ensures result.@dl = FileIO.OPEN when result._nonnull != 0
  scope_exit result.@dl == FileIO.CLOSED when result._nonnull != 0
}

fn dlclose(1) {
  ensures arg0.@dl = FileIO.CLOSED
}

# =========================================================================
# RESOURCE TRACKING - Memory mapping (@mapped ghost field)
# =========================================================================

fn mmap(6) {
  ensures result.@mapped = Alloc.ALLOCATED
  scope_exit result.@mapped == Alloc.FREED
}

fn munmap(2) {
  ensures arg0.@mapped = Alloc.FREED
}

# =========================================================================
# RESOURCE TRACKING - POSIX semaphores (@sem ghost field)
# =========================================================================

fn sem_open(2) {
  ensures result.@sem = InitState.INITIALIZED
  scope_exit result.@sem == InitState.DESTROYED
}

fn sem_open(4) {
  ensures result.@sem = InitState.INITIALIZED
  scope_exit result.@sem == InitState.DESTROYED
}

fn sem_close(1) {
  ensures arg0.@sem = InitState.DESTROYED
}

# =========================================================================
# RESOURCE TRACKING - POSIX message queues (@mq ghost field)
# =========================================================================

fn mq_open(2) {
  ensures result.@mq = InitState.INITIALIZED
  scope_exit result.@mq == InitState.DESTROYED
}

fn mq_open(4) {
  ensures result.@mq = InitState.INITIALIZED
  scope_exit result.@mq == InitState.DESTROYED
}

fn mq_close(1) {
  ensures arg0.@mq = InitState.DESTROYED
}

