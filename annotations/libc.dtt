# zlib decompression (tainted compressed data -> tainted output)
fn inflate(2) {
  propagates arg0 -> arg0
}

# Network address conversion (tainted addr -> tainted result)
fn inet_ntoa(1) {
  propagates arg0 -> result
}

fn inet_aton(2), inet_pton(3) {
  propagates arg0 -> arg1
  propagates arg0 -> result
