  requires arg1._nonnull != 0 "string pointer may be null"
}

fn strpbrk(2) {
  requires arg0._nonnull != 0 "string pointer may be null"
  requires arg1._nonnull != 0 "string pointer may be null"
}

fn strcspn(2) {
  requires arg0._nonnull != 0 "string pointer may be null"
  requires arg1._nonnull != 0 "string pointer may be null"
}

fn strspn(2) {
  requires arg0._nonnull != 0 "string pointer may be null"
  requires arg1._nonnull != 0 "string pointer may be null"
}

