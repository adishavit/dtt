# i18n (tainted message id -> tainted translated string if catalog is compromised)
fn gettext(1), dcgettext(3) {
  propagates arg0 -> result
}

fn dgettext(2), ngettext(3) {
  propagates arg0 -> result
  propagates arg1 -> result
}

fn dngettext(4), dcngettext(5) {
  propagates arg0 -> result
  propagates arg1 -> result
  propagates arg2 -> result
}
